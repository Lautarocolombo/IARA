# IARA - Variables de Entorno
# Copiar este archivo a .env y completar con los valores reales
# Importante: NUNCA commitear el archivo .env real (contiene secrets)

# ============================================================
# OBLIGATORIAS (siempre)
# ============================================================
# Credenciales de administrador
# Usuario: Iara
# Generar hash: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('tu-clave', 10).then(h => console.log(h))"
ADMIN_USER=Iara
ADMIN_PASS_HASH=CHANGE_ME_GENERATE_WITH_BCRYPT

# JWT y CSRF
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO
CSRF_SECRET=CHANGE_ME_GENERATE_WITH_CRYPTO

# ============================================================
# OBLIGATORIAS EN PRODUCCIÓN
# ============================================================
# Base de datos (PostgreSQL para producción, SQLite para desarrollo local)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# CORS (orígenes permitidos separados por coma sin espacios)
ALLOWED_ORIGINS=https://artesaniagualeguay.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:3001

# ============================================================
# URLs
# ============================================================
# SITE_URL: usada en sitemap.xml y como base para URLs públicas
SITE_URL=https://artesaniagualeguay.vercel.app
# BACKEND_URL: usada para armar URLs absolutas de uploads y assets
BACKEND_URL=https://iara-backend.onrender.com

# ============================================================
# NEGOCIO
# ============================================================
BUSINESS_NAME=Artesanías Gualeguay
BUSINESS_EMAIL=chicafittargentina@gmail.com
WHATSAPP=+5493444634444
INSTAGRAM_URL=https://instagram.com/tu-cuenta
FACEBOOK_URL=https://facebook.com/tu-pagina
TWITTER_URL=https://twitter.com/tu-cuenta

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com

# ============================================================
# ANALYTICS / MONITOREO
# ============================================================
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=PIXEL_ID
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx
LOG_LEVEL=info

# ============================================================
# ALMACENAMIENTO DE IMÁGENES
# ============================================================
# Vercel Blob (persistente en producción)
BLOB_READ_WRITE_TOKEN=
# Cloudinary (alternativa)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# OPCIONALES AVANZADAS
# ============================================================
# Redis (para queues de imágenes). Si está vacío, se opera sin Redis.
REDIS_URL=
# Minutos de reserva de stock para transferencias
TRANSFER_RESERVATION_MINUTES=45
# IPs permitidas para endpoint de métricas (separadas por coma)
METRICS_ALLOWED_IPS=
# Token para endpoint de métricas
METRICS_TOKEN=
# Tests (opcional)
TEST_BASE_URL=http://localhost:3000

# ============================================================
# ENVÍO
# ============================================================
SHIPPING_COST=200
SHIPPING_THRESHOLD=2000
