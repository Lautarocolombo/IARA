# IARA - Variables de Entorno
# Copiar este archivo a .env y completar con los valores reales
# Importante: NUNCA commitear el archivo .env real (contiene secrets)

# Credenciales de administrador
# Usuario: Iara
# Generar hash: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('pulseras2026', 10).then(h => console.log(h))"
ADMIN_USER=Iara
# Hash bcrypt para "pulseras2026" (cámbialo tras primer login via /api/admin/change-password)
ADMIN_PASS_HASH=$2b$10$w5YhXTWi/AKpu8cifWV7iOSOcz8w1sqxCUJFBWBlCSinL2PIUnfKa

# JWT y CSRF
# Generar JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=118af887f620ebecd52149dac56fc75fe40537e7b47190e5ebbcfa928509ebab1cacb8cdb1044535186e7cf5c93d0a2a661b3db782752b710d6d71d64bf5eec2
CSRF_SECRET=e16ffa92f500a4170368bb2765829a46ec26c804f8f66d67e4ae8f22edb18f39

# Base de datos (PostgreSQL para producción, SQLite para desarrollo local)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com

# URLs
# SITE_URL: usada en sitemap.xml (las imágenes se sirven por path relativo → funciona con Vercel rewrite)
SITE_URL=https://iara-ivory.vercel.app
ALLOWED_ORIGINS=https://iara-ivory.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000,http://localhost:5173

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=PIXEL_ID

# Cloudinary (PARA PRODUCCIÓN: requerido para persistencia de imágenes)
# Sin estas variables, las imágenes se guardan localmente y se pierden al reinicio de Render.
# Configurá estas variables en el Render Dashboard → Settings → Environment
# CLOUDINARY_CLOUD_NAME=tu-cloud-name
# CLOUDINARY_API_KEY=tu-api-key
# CLOUDINARY_API_SECRET=tu-api-secret

# Configuración del negocio
BUSINESS_NAME=Artesanías Gualeguay
