# =============================================================================
# IARA — Variables de Entorno (root)
# =============================================================================
# Copiar este archivo a .env y completar con los valores reales.
# NUNCA commitear el archivo .env real (contiene secrets).
#
# El proyecto no usa workspaces. Backend y frontend tienen package.json
# separados. Este .env.example cubre variables para AMBOS entornos.
# El backend también usa backend/.env.example con las vars específicas del servidor.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO
# -----------------------------------------------------------------------------

# Entorno de ejecución del backend (development | production | test)
NODE_ENV=production

# Puerto en el que escucha el backend (default: 3000)
PORT=3000

# Nivel de logging de pino (error | warn | info | debug | trace)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. AUTENTICACIÓN & SEGURIDAD
# -----------------------------------------------------------------------------

# Usuario admin inicial (se crea si la tabla está vacía)
ADMIN_USER=Iara

# Hash bcrypt de la contraseña admin.
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 10))"
# O: npx bcrypt-cli hash
ADMIN_PASS_HASH=

# JWT signing secret — generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CSRF secret — generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se configura, CSRF se desactiva (menos protegido)
CSRF_SECRET=

# -----------------------------------------------------------------------------
# 3. BASE DE DATOS
# -----------------------------------------------------------------------------

# PostgreSQL para producción. Si no está seteado, usa SQLite local (data/iara.db)
# Formato: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# 4. CORS / ORÍGENES PERMITIDOS
# -----------------------------------------------------------------------------

# Lista separada por comas de orígenes permitidos (required para producción)
ALLOWED_ORIGINS=https://artesania-gualeguay-v3.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000,http://localhost:5173

# Variante singular (fallback usada por server.js y csrf.js)
ALLOWED_ORIGIN=https://artesania-gualeguay-v3.vercel.app

# -----------------------------------------------------------------------------
# 5. URLs
# -----------------------------------------------------------------------------

# URL pública del frontend (para sitemap.xml, links, etc.)
SITE_URL=https://artesania-gualeguay-v3.vercel.app

# URL pública del backend (Render). Se usa para armar URLs absolutas de imágenes/assets.
# Si no está seteado, el backend usa SITE_URL o paths relativos.
BACKEND_URL=https://iara-os3h.onrender.com

# -----------------------------------------------------------------------------
# 6. EMAIL (Resend)
# -----------------------------------------------------------------------------

RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com
ADMIN_EMAIL=admin@artesaniagualeguay.com

# -----------------------------------------------------------------------------
# 7. MERCADO PAGO (opcional — transferencia bancaria es el método por defecto)
# -----------------------------------------------------------------------------

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_INTEGRATOR_ID=

# -----------------------------------------------------------------------------
# 8. REDIS / COLAS (opcional)
# -----------------------------------------------------------------------------
# Requerido para sesiones persistentes y colas de trabajo (BullMQ).
# Si no se configura, las sesiones son en memoria (se pierden al reiniciar).
REDIS_URL=

# -----------------------------------------------------------------------------
# 9. ANALYTICS & MONITORING
# -----------------------------------------------------------------------------
# También configurables desde el panel admin (Configuración > Integraciones),
# que guarda en site_settings y tiene prioridad sobre estas vars.

GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=PIXEL_ID
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx
GOOGLE_PLACE_ID=
GOOGLE_WRITE_REVIEW_URL=
GOOGLE_MAPS_API_KEY=

# Flag: incluir detalles de errores en respuestas API (development only)
DEBUG_API_ERROR=

# -----------------------------------------------------------------------------
# 10. FILE STORAGE
# -----------------------------------------------------------------------------

# Vercel Blob — token de read+write (obligatorio en producción con Render/Vercel)
# Crear un store en https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# Cloudinary cloud name (opcional — para transformaciones de imágenes)
CLOUDINARY_CLOUD_NAME=

# -----------------------------------------------------------------------------
# 11. NEGOCIO
# -----------------------------------------------------------------------------

BUSINESS_NAME=Artesanías Gualeguay
BUSINESS_EMAIL=contacto@artesaniagualeguay.com
# WhatsApp: formato E.164 SIN 9 para Argentina → 543444634444
# El 9 intermedio es para links tel: (llamadas normales), NO para wa.me
# CONFIRMAR con el dueño que este es el número real de WhatsApp Business.
WHATSAPP=+543444634444
# Fallback solo frontend (utils/whatsapp.js) — normalmente viene de CONFIG.CONTACT.WHATSAPP
VITE_WHATSAPP_NUMBER=+543444634444
INSTAGRAM_URL=https://www.instagram.com/artesaniagualeguay
FACEBOOK_URL=https://www.facebook.com/artesaniagualeguay
TWITTER_URL=

# -----------------------------------------------------------------------------
# 12. ENVÍO
# -----------------------------------------------------------------------------

SHIPPING_COST=200
SHIPPING_THRESHOLD=2000

# -----------------------------------------------------------------------------
# 13. MÉTRICAS (opcional)
# -----------------------------------------------------------------------------

# Token de autenticación para el endpoint /metrics
METRICS_TOKEN=

# Lista separada por comas de IPs permitidas para /metrics (además del token)
METRICS_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# 14. TESTS E2E (opcional)
# -----------------------------------------------------------------------------

TEST_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 15. MIGRACIÓN DE IMÁGENES (scripts, opcional)
# -----------------------------------------------------------------------------

# Ejecutar migraciones en modo dry-run (no escribe cambios)
DRY_RUN=false

# -----------------------------------------------------------------------------
# 16. PLATFORM (auto-set, no modificar)
# -----------------------------------------------------------------------------

# Estas variables son configuradas automáticamente por la plataforma de hosting
# (Vercel / Render). No es necesario definirlas manualmente.
# VERCEL — "true" cuando corre en Vercel
# RENDER_EXTERNAL_HOSTNAME — hostname asignado por Render
