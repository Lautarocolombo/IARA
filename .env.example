# IARA - Variables de Entorno
# Copiar este archivo a .env y completar con los valores reales

# Credenciales de administrador
# Usuario: lara
# Opcional: ADMIN_PASS_HASH (bcrypt). Si está seteado, se prioriza sobre ADMIN_PASS.
# Generar hash: node -e "const bcrypt = require('bcrypt'); bcrypt.hash('pulseras2026', 10).then(h => console.log(h))"
ADMIN_USER=Iara
# Si ADMIN_PASS_HASH está seteado, se usa con prioridad sobre ADMIN_PASS
# Si el hash es obsoleto (bcrypt.compare devuelve false), el código cae al fallback de ADMIN_PASS
ADMIN_PASS_HASH=
ADMIN_PASS=pulseras2026

# JWT y CSRF
# Generar JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
CSRF_SECRET=

# Base de datos (PostgreSQL para producción, SQLite para desarrollo local)
DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com

# URLs
SITE_URL=https://iara-ivory.vercel.app
ALLOWED_ORIGINS=https://iara-ivory.vercel.app,http://localhost:3000

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=PIXEL_ID

# Cloudinary (para uploads persistentes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Configuración del negocio
BUSINESS_NAME=Artesanías Gualeguay
BUSINESS_EMAIL=chicafittargentina@gmail.com
WHATSAPP=+5493444634444
INSTAGRAM_URL=https://instagram.com/tu-cuenta
FACEBOOK_URL=https://facebook.com/tu-pagina
TWITTER_URL=https://twitter.com/tu-cuenta

# Envío
SHIPPING_COST=200
SHIPPING_THRESHOLD=2000
