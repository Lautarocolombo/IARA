const { test } = require('@playwright/test');

const seed = [{ id: 1, name: 'Pulsera Test', price: 1500, qty: 2, emoji: '🧵', image: '', description: 'desc', stock: 99 }];

test('DEBUG remove click with full logging', async ({ page }) => {
  page.on('console', msg => console.log('[PAGE]', msg.type(), msg.text().slice(0, 220)));
  page.on('pageerror', err => console.log('[PAGEERROR]', err.message));

  await page.goto('/pages/cart.html');
  await page.evaluate(c => localStorage.setItem('ag_cart', JSON.stringify(c)), seed);
  await page.reload();
  await page.waitForLoadState('domcontentloaded');
  await page.waitForTimeout(1500);

  console.log('--- antes remove ---');
  console.log('getCart:', await page.evaluate(() => window.getCart()));
  console.log('removeFromCart type:', await page.evaluate(() => typeof window.removeFromCart));

  console.log('--- clicking remove button ---');
  await page.click('#cartItems button[data-cart-action="remove"]');
  await page.waitForTimeout(800);

  console.log('--- despues remove ---');
  console.log('getCart:', await page.evaluate(() => window.getCart()));
  const count = await page.$$eval('#cartItems .cart-item', els => els.length);
  console.log('DOM count:', count);
  console.log('subtotal:', await page.$eval('#subtotal', el => el.textContent));
  console.log('empty visible:', await page.isVisible('#emptyCart'));
});
