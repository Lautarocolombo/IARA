{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "CONFIG": "readonly",
    "formatARS": "readonly",
    "getWhatsAppLink": "readonly",
    "getMailtoLink": "readonly",
    "getGoogleWriteReviewLink": "readonly",
    "showToast": "readonly",
    "fetchWithRetry": "readonly",
    "adminFetch": "readonly",
    "getFetchErrorMessage": "readonly",
    "renderProductImage": "readonly",
    "getProductImageUrl": "readonly",
    "escapeHtml": "readonly",
    "DOMPurify": "readonly",
    "initSiteHeader": "readonly",
    "initNavbarScroll": "readonly",
    "initMobileNavbar": "readonly",
    "initSSESync": "readonly",
    "destroySSESync": "readonly",
    "emitSync": "readonly",
    "startDataSync": "readonly",
    "stopDataSync": "readonly",
    "onSyncMessage": "readonly",
    "addToCart": "readonly",
    "getCart": "readonly",
    "removeFromCart": "readonly",
    "updateCartQty": "readonly",
    "clearCart": "readonly",
    "addToWishlist": "readonly",
    "removeFromWishlist": "readonly",
    "isInWishlist": "readonly",
    "getWishlist": "readonly",
    "updateWishlistBadge": "readonly",
    "renderProducts": "readonly",
    "getProducts": "readonly",
    "fetchProducts": "readonly",
    "getProductsByCategory": "readonly",
    "renderFeaturedProducts": "readonly",
    "loadHeroCards": "readonly",
    "loadTestimonials": "readonly",
    "loadSiteTexts": "readonly",
    "loadMpAlias": "readonly",
    "loadProduct": "readonly",
    "openModalScrollLock": "readonly",
    "unlockModalScroll": "readonly"
  },
  "overrides": [
    {
      "files": ["tests/**/*.js"],
      "env": {
        "jest": true
      },
      "globals": {
        "describe": "readonly",
        "test": "readonly",
        "expect": "readonly",
        "beforeEach": "readonly",
        "afterEach": "readonly",
        "jest": "readonly"
      },
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["tests/e2e/**/*.js"],
      "rules": {
        "no-console": "off",
        "no-unused-vars": "off"
      }
    },
{
    "files": ["frontend/js/admin-*.js", "frontend/js/*-dashboard.js", "frontend/js/*-sales.js", "frontend/js/*-payments.js", "frontend/js/admin.js", "frontend/js/pages/dashboard.js"],
    "globals": {
      "initAdminDashboard": "readonly",
      "initContentEditor": "readonly",
      "initProductManager": "readonly",
      "initCategoryManager": "readonly",
      "initSalesPanel": "readonly",
      "initOrdersPanel": "readonly",
      "initPaymentsPanel": "readonly",
      "doLogout": "readonly",
      "loadOrders": "readonly",
      "loadSalesReport": "readonly",
      "loadSiteSettings": "readonly",
      "loadSalesSummary": "readonly",
      "Chart": "readonly",
      "Quill": "readonly",
      "initRevealAnimation": "readonly"
    }
  },
  {
    "files": ["frontend/js/checkout.js", "frontend/js/pages/checkout.js", "frontend/js/cart.js"],
    "globals": {
      "loadPaymentConfig": "readonly",
      "copyTransferField": "readonly",
      "updateCartBadge": "readonly",
      "updateCartDisplay": "readonly"
    }
  },
  {
    "files": ["frontend/js/home-init.js"],
    "globals": {
      "loadSiteSettings": "readonly"
    }
  },
  {
    "files": ["frontend/js/ui.js"],
    "globals": {
      "loadOrders": "readonly",
      "loadSalesReport": "readonly",
      "renderWishlist": "readonly"
    }
  },
  {
    "files": ["frontend/js/pages/product.js", "frontend/js/cart.js", "frontend/js/wishlist.js", "frontend/js/home-init.js"],
    "globals": {
      "renderWishlist": "readonly"
    }
  },
  {
    "files": ["frontend/js/analytics.js", "frontend/js/vercel-analytics.js"],
    "globals": {
      "loadVercelAnalytics": "readonly",
      "disableVercelAnalytics": "readonly",
      "initVercelQueues": "readonly"
    }
  },
  {
    "files": ["frontend/js/tracking.js", "frontend/js/hero.js", "frontend/js/admin.js"],
    "globals": {
      "Sentry": "readonly"
    }
  },
  {
    "files": ["frontend/pages/contact.html", "frontend/js/contact.js", "frontend/js/pages/cesion-ubicacion.js"],
    "globals": {
      "google": "readonly",
      "initMap": "readonly"
    }
  },
  {
    "files": ["frontend/js/pages/cart.js"],
    "globals": {
      "initRevealAnimation": "readonly",
      "loadPaymentConfig": "readonly"
    }
  },
  {
    "files": ["frontend/js/pages/product.js"],
    "globals": {
      "defaultProducts": "readonly",
      "submitReview": "readonly"
    }
  }
  ],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-undef": "error",
    "semi": ["error", "always"],
    "quotes": ["error", "single"]
  }
}