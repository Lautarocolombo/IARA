{
  "name": "artesania-gualeguay",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:qrcode": "npx browserify -r qrcode -s QRCode -o frontend/js/vendor/qrcode.js",
    "build": "npx vite build",
    "preview": "npx vite preview",
    "test": "jest --config tests/unit/jest.config.js --testEnvironment jsdom --passWithNoTests",
    "test:coverage": "jest --config tests/unit/jest.config.js --testEnvironment jsdom --coverage",
    "test:backend": "cd backend && npm test",
    "test:frontend": "npm test",
    "lint": "eslint frontend/js/ tests/ --ext .js",
    "lint:backend": "cd backend && npm run lint",
    "format": "prettier --write \"**/*.{js,json,css,html}\"",
    "lint:fix": "eslint frontend/js/ tests/ --ext .js --fix",
    "dev": "cd backend && npm start",
    "start": "cd backend && npm start"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "artillery": "^2.0.33",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.0.0",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@sentry/node": "^8.x",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-pg-migrate": "^9.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^8.21.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.0",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
