# Git attributes - Normalización de line endings y codificación
# https://git-scm.com/docs/gitattributes

* text=auto eol=lf

# Archivos de texto: forzar UTF-8 sin BOM
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env* text eol=lf
*.config text eol=lf

# Imágenes y binarios: no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Archivos que deben mantener line endings específicos (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf