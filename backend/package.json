{
  "description": "Artesania Gualeguay backend with hero-cards and site-settings routes",
  "name": "artesania-gualeguay-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --config jest.config.js --runInBand",
    "test:ci": "jest --config jest.config.js --testTimeout=60000 --runInBand --forceExit",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"**/*.{js,json}\"",
    "lint:fix": "eslint src --ext .js --fix",
    "migrate": "node src/scripts/run-migrations.js up",
    "migrate:down": "node src/scripts/run-migrations.js down",
    "migrate:check": "node src/scripts/run-migrations.js check",
    "migrate:create": "node -e \"const fs=require('fs');const d=new Date();const p=x=>String(x).padStart(2,'0');const ts=''+d.getFullYear()+p(d.getMonth()+1)+p(d.getDate())+p(d.getHours())+p(d.getMinutes())+p(d.getSeconds());const name=(process.argv[2]||'change').replace(/[^a-zA-Z0-9_]/g,'_');const f='migrations/'+ts+'_'+name+'.sql';fs.writeFileSync(f,'-- '+name+'\\n');console.log(f)\"",
    "backup": "node src/scripts/backup.js"
  },
  "dependencies": {
    "@sentry/node": "^8.x",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-pg-migrate": "^9.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^8.21.0",
    "redis": "^6.3.0",
    "sharp": "^0.33.0",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "bullmq": "^6.3.12",
    "ioredis": "^6.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/sharp": "^0.31.1",
    "@types/validator": "^13.15.10",
    "@types/xlsx": "^0.0.35",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
