{
  "description": "Artesania Gualeguay backend with hero-cards and site-settings routes",
  "name": "artesania-gualeguay-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --config jest.config.js",
    "test:ci": "jest --config jest.config.js --coverage",
    "test:coverage": "jest --config jest.config.js --coverage",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"**/*.{js,json}\"",
    "lint:fix": "eslint src --ext .js --fix",
    "migrate": "node scripts/run-migrations.js up",
    "migrate:down": "node scripts/run-migrations.js down",
    "migrate:create": "node -e \"const fs=require('fs');const d=new Date();const n='migrations/'+['00','00',d.getMinutes(),d.getSeconds()].join('');const f=n+'_'+process.argv[2].replace(/[^a-z0-9_]/g,'_')+'.js';fs.writeFileSync(f,'\\'use strict\\';\\nmodule.exports = {\\n  name: \\''+process.argv[2]+'\\',\\n  async up(sql) {\\n    // TODO\\n  },\\n  async down(sql) {\\n    // TODO\\n  },\\n};\\n');console.log(f)\"",
    "migrate:tenants": "node scripts/migrate-tenants.js",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@sentry/node": "^8.x",
    "@vercel/blob": "^2.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.6",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-pg-migrate": "^9.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "pino": "^8.21.0",
    "sharp": "^0.33.0",
    "validator": "^13.15.35",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^7.2.2"
  }
}
