# Backend environment variables
# Copiá este archivo a .env y completá los valores

NODE_ENV=development
PORT=3000

# Admin credentials
# Generar hash: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('tupassword',10).then(h=>console.log(h))"
# ADMIN_USER=Iara
# ADMIN_PASS_HASH=$2b$10$...

# JWT y Refresh Token
JWT_SECRET=change_me_in_production_use_a_secure_random_string

# Base de datos (PostgreSQL en producción)
# Conexión a Neon configurada en Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# CORS (separados por coma sin espacios)
ALLOWED_ORIGINS=https://iara-peach.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000

# Cloudinary (opcional - para upload de imágenes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Logging
LOG_LEVEL=info
