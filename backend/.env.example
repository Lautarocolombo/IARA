# Backend environment variables
# Copiá este archivo a .env y completá los valores
# Importante: NUNCA commitear el archivo .env real (contiene secrets)

NODE_ENV=development
PORT=3000

# Admin credentials
# Generar hash: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('pulseras2026',10).then(h=>console.log(h))"
ADMIN_USER=Iara
ADMIN_PASS_HASH=$2b$10$/v6H65cfn3.jp0C9Ojugcen9/gWABfQtSSR3oFTDRwU232w15Vom.

# JWT
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=118af887f620ebecd52149dac56fc75fe40537e7b47190e5ebbcfa928509ebab1cacb8cdb1044535186e7cf5c93d0a2a661b3db782752b710d6d71d64bf5eec2

# Base de datos (PostgreSQL en producción)
# Conexión a Neon configurada en Render
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# CORS (separados por coma sin espacios)
ALLOWED_ORIGINS=https://iara-ivory.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000

# Site URL (usado en sitemap.xml)
SITE_URL=https://iara-ivory.vercel.app

# Cloudinary (REQUERIDO en producción para persistencia de imágenes)
# Sin estas, las imágenes se guardan localmente y se pierden al reinicio de Render
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com

# URLs
SITE_URL=https://iara-ivory.vercel.app
BACKEND_URL=https://tu-backend.onrender.com

# Logging
LOG_LEVEL=info

# Configuración del negocio
BUSINESS_NAME=Artesanías Gualeguay
WHATSAPP=+5493444634444
SHIPPING_COST=200
SHIPPING_THRESHOLD=2000
