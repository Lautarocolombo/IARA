# =============================================================================
# Backend — Variables de Entorno
# =============================================================================
# Copiar a .env y completar. NUNCA commitear .env real.
# Este archivo lista TODAS las variables que el backend necesita para producción.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ENTORNO
# -----------------------------------------------------------------------------

# Entorno de ejecución (development | production | test)
NODE_ENV=production

# Puerto del servidor (default: 3000)
PORT=3000

# Nivel de logging de pino (error | warn | info | debug | trace)
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 2. AUTENTICACIÓN & SEGURIDAD
# -----------------------------------------------------------------------------

# Username admin inicial (se crea si la tabla está vacía)
ADMIN_USER=Iara

# Hash bcrypt de la contraseña admin.
# Generar con: node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 10))"
ADMIN_PASS_HASH=

# JWT signing secret — generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# CSRF secret — generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si no se configura, CSRF se desactiva (menos protegido pero funciona)
CSRF_SECRET=

# Email del admin para notificaciones
ADMIN_EMAIL=admin@artesaniagualeguay.com

# -----------------------------------------------------------------------------
# 3. BASE DE DATOS
# -----------------------------------------------------------------------------

# PostgreSQL para producción. Si no está seteado, usa SQLite local (data/iara.db)
# Formato E.164: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# 4. CORS / ORÍGENES PERMITIDOS
# -----------------------------------------------------------------------------

# Lista separada por comas de orígenes permitidos (required)
ALLOWED_ORIGINS=https://artesania-gualeguay-v3.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000,http://localhost:5173

# Variante singular (fallback usada por server.js y csrf.js)
ALLOWED_ORIGIN=https://artesania-gualeguay-v3.vercel.app

# -----------------------------------------------------------------------------
# 5. URLs
# -----------------------------------------------------------------------------

# URL pública del frontend
SITE_URL=https://artesania-gualeguay-v3.vercel.app

# URL pública del frontend (para assets estáticos como /imagenes/*)
FRONTEND_URL=https://artesania-gualeguay-v3.vercel.app

# URL pública del backend (Render). Para armar URLs absolutas de assets.
# Si no está seteado, el backend usa SITE_URL o paths relativos.
BACKEND_URL=https://iara-os3h.onrender.com

# -----------------------------------------------------------------------------
# 6. EMAIL (Resend)
# -----------------------------------------------------------------------------

RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_EMAIL=admin@artesaniagualeguay.com

# -----------------------------------------------------------------------------
# 7. MERCADO PAGO (opcional)
# -----------------------------------------------------------------------------

MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_INTEGRATOR_ID=

# -----------------------------------------------------------------------------
# 8. REDIS (opcional)
# -----------------------------------------------------------------------------
# Requerido para sesiones persistentes y colas de trabajo (BullMQ).
# Si no se configura, las sesiones son en memoria (se pierden al reiniciar).
REDIS_URL=

# -----------------------------------------------------------------------------
# 9. ANALYTICS & MONITORING
# -----------------------------------------------------------------------------

GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
FACEBOOK_PIXEL_ID=PIXEL_ID
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx
GOOGLE_PLACE_ID=
GOOGLE_WRITE_REVIEW_URL=
GOOGLE_MAPS_API_KEY=

# Flag: incluir detalles de errores en respuestas API (development only)
DEBUG_API_ERROR=

# -----------------------------------------------------------------------------
# 10. FILE STORAGE
# -----------------------------------------------------------------------------

# Vercel Blob — token de read+write (obligatorio en producción)
# Crear un store en https://vercel.com/dashboard/stores
BLOB_READ_WRITE_TOKEN=

# Cloudinary cloud name (opcional — transformaciones de imágenes)
CLOUDINARY_CLOUD_NAME=

# -----------------------------------------------------------------------------
# 11. NEGOCIO
# -----------------------------------------------------------------------------

BUSINESS_NAME=Artesanías Gualeguay
BUSINESS_EMAIL=contacto@artesaniagualeguay.com
# WhatsApp: formato E.164 SIN 9 para Argentina → 543444634444
WHATSAPP=+543444634444
INSTAGRAM_URL=https://www.instagram.com/artesaniagualeguay
FACEBOOK_URL=https://www.facebook.com/artesaniagualeguay
TWITTER_URL=

# -----------------------------------------------------------------------------
# 12. ENVÍO
# -----------------------------------------------------------------------------

SHIPPING_COST=200
SHIPPING_THRESHOLD=2000

# -----------------------------------------------------------------------------
# 13. MÉTRICAS (opcional)
# -----------------------------------------------------------------------------

# Token de autenticación para el endpoint /metrics
METRICS_TOKEN=

# Lista separada por comas de IPs permitidas para /metrics
METRICS_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# 14. TESTS (E2E)
# -----------------------------------------------------------------------------

TEST_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 15. SCRIPTS DE MIGRACIÓN (opcional, solo para scripts CLI)
# -----------------------------------------------------------------------------

# Ejecutar migraciones de imágenes en modo dry-run (no escribe cambios)
DRY_RUN=false

# -----------------------------------------------------------------------------
# 17. DOCUMENTACIÓN API
# -----------------------------------------------------------------------------
# Swagger UI (opcional — si se configura, se habilita documentación interactiva)
# SWAGGER_ENABLED=true

# -----------------------------------------------------------------------------
# 18. PLATFORM (auto-set, no modificar)
# -----------------------------------------------------------------------------
# VERCEL — "true" cuando corre en Vercel (auto-set por Vercel)
# RENDER_EXTERNAL_HOSTNAME — hostname asignado por Render (auto-set por Render)
