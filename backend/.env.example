# Backend environment variables
# Copiá este archivo a .env y completá los valores

NODE_ENV=development
PORT=3000

# Admin credentials
# Opción 1 (recomendado): usar ADMIN_PASS_HASH (bcrypt)
#   Generar hash: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('pulseras2026',10).then(h=>console.log(h))"
# ADMIN_USER=Iara
# ADMIN_PASS_HASH=$2b$10$...

# Opción 2 (fallback): usar ADMIN_PASS en texto plano
# El código intenta bcrypt.compare primero; si falla (hash obsoleto o false),
# cae al fallback de ADMIN_PASS en texto plano.
# ADMIN_USER=Iara
# ADMIN_PASS=pulseras2026

# JWT y Refresh Token
JWT_SECRET=change_me_in_production_use_a_secure_random_string

# Base de datos (PostgreSQL en producción)
# Conexión a Neon configurada en Render
DATABASE_URL=postgresql://neondb_owner:npg_FKbM0xfQ3Lpd@ep-purple-water-axuf1ls3-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# CORS (separados por coma sin espacios)
ALLOWED_ORIGINS=https://iara-peach.vercel.app,https://*.vercel.app,https://artesaniagualeguay.com,http://localhost:3000

# Cloudinary (opcional - para upload de imágenes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# URLs
SITE_URL=https://iara-lovat.vercel.app
BACKEND_URL=https://tu-backend.onrender.com

# Logging
LOG_LEVEL=info
