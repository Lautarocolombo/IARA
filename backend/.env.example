# Backend environment variables
# Copiá este archivo a .env y completá los valores
# Importante: NUNCA commitear el archivo .env real (contiene secrets)

# ============================================================
# OBLIGATORIAS (siempre)
# ============================================================
NODE_ENV=development
PORT=3000

# Admin credentials
# Generar hash: node -e "const bcrypt=require('bcrypt'); bcrypt.hash('tu-pass',10).then(h=>console.log(h))"
ADMIN_USER=Iara
ADMIN_PASS_HASH=<tu-hash-bcrypt-aqui>

# JWT y CSRF
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<tu-jwt-secret-aqui>
CSRF_SECRET=<tu-csrf-secret-aqui>

# ============================================================
# OBLIGATORIAS EN PRODUCCIÓN
# ============================================================
# Conexión a PostgreSQL (Render la provee automáticamente)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# CORS (orígenes permitidos separados por coma sin espacios)
ALLOWED_ORIGINS=https://artesaniagualeguay.vercel.app,https://*.vercel.app,http://localhost:3000,http://localhost:3001

# ============================================================
# URLs
# ============================================================
SITE_URL=https://artesaniagualeguay.vercel.app
BACKEND_URL=https://iara-backend.onrender.com

# ============================================================
# EMAIL (Resend)
# ============================================================
RESEND_API_KEY=
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com

# ============================================================
# ANALYTICS / MONITOREO
# ============================================================
SENTRY_DSN=https://xxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx
LOG_LEVEL=info

# ============================================================
# ALMACENAMIENTO DE IMÁGENES
# ============================================================
# Vercel Blob (persistente en producción)
BLOB_READ_WRITE_TOKEN=
# Cloudinary (alternativa)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================================
# OPCIONALES AVANZADAS
# ============================================================
# Redis (para queues de imágenes). Si está vacío, se opera sin Redis.
REDIS_URL=
# Minutos de reserva de stock para transferencias
TRANSFER_RESERVATION_MINUTES=45
# IPs permitidas para endpoint de métricas (separadas por coma)
METRICS_ALLOWED_IPS=
# Token para endpoint de métricas
METRICS_TOKEN=
WHATSAPP=+5493444634444
SHIPPING_COST=200
SHIPPING_THRESHOLD=2000
