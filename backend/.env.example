# ===== Configuración del entorno Backend =====

# Entorno (development | production | test)
NODE_ENV=production

# Puerto del servidor
PORT=3000

# ===== Autenticación =====
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Usuario admin inicial (se crea si no existe)
ADMIN_USER=Iara

# Hash bcrypt de la contraseña admin (generar con: npx bcrypt-cli hash)
# O: node -e "console.log(require('bcryptjs').hashSync('tu-contraseña', 10))"
ADMIN_PASS_HASH=

# ===== Base de datos =====
# Si no se configura, usa SQLite local (data/iara.db)
# Formato PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ===== CORS / Orígenes permitidos =====
# Lista separada por comas de orígenes permitidos
ALLOWED_ORIGINS=https://artesaniagualeguay.com,https://*.vercel.app,http://localhost:3000,http://localhost:5173

# ===== URLs =====
SITE_URL=https://artesaniagualeguay.com
BACKEND_URL=https://api.artesaniagualeguay.com

# ===== Envío =====
SHIPPING_COST=200
SHIPPING_THRESHOLD=2000

# ===== Emails (Resend) =====
EMAIL_FROM=noreply@artesaniagualeguay.com
ADMIN_NOTIFICATION_EMAIL=admin@artesaniagualeguay.com
RESEND_API_KEY=

# ===== WhatsApp =====
WHATSAPP=+5493444634444

# ===== Mercado Pago (opcional) =====
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_INTEGRATOR_ID=

# ===== Redis / Colas (opcional) =====
REDIS_URL=

# ===== Sentry (opcional) =====
SENTRY_DSN=

# ===== Vercel Blob (persistencia de imágenes) =====
# Obligatorio en producción (Render). Crear un store en https://vercel.com/dashboard/stores
# y pegar el token de read+write. Sin esto, las imágenes se guardan en /tmp y se pierden en cada redeploy.
BLOB_READ_WRITE_TOKEN=

# ===== Logging =====
LOG_LEVEL=info

# ===== Métricas (opcional) =====
METRICS_TOKEN=
METRICS_ALLOWED_IPS=
