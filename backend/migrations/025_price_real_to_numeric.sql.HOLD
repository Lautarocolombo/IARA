-- =============================================================================
-- 025_price_real_to_numeric — CONVERSIÓN REAL → NUMERIC(12,2)
-- ESTADO: EN ESPERA (.HOLD). El migrador IGNORA este archivo a propósito.
-- =============================================================================
-- POR QUÉ EN ESPERA: convierte columnas de dinero de REAL (float binario,
-- artefactos tipo 0.30000000000000004) a NUMERIC(12,2) exacto. Es un cambio
-- de esquema sobre Neon PRODUCCIÓN y, por regla del proyecto, debe probarse
-- primero en staging. NO renombrar a .sql sin completar el runbook.
--
-- RUNBOOK (hacer en orden, con confirmación del dueño antes del paso 4):
--   1. Backup: pg_dump $DATABASE_URL > backup-antes-025.sql
--   2. Crear un branch de Neon desde producción y apuntar una instancia de
--      staging a ese branch (DATABASE_URL del branch).
--   3. Renombrar este archivo a 025_price_real_to_numeric.sql SOLO en staging,
--      correr `npm run migrate` (backend/) y verificar:
--        a) el boot no falla y el log muestra "Migración aplicada" sin errores;
--        b) SELECT de verificación (abajo) devuelve 0 filas en todas las tablas;
--        c) `npm test` (backend) en verde contra staging;
--        d) el panel admin muestra precios/totales idénticos (spot-check).
--   4. Recién entonces, aplicar en producción en horario valle, con el backup
--      del paso 1 a mano y el dueño avisado.
--   5. COMPATIBILIDAD DE CÓDIGO: pg devuelve NUMERIC como string. El backend
--      ya envuelve lecturas monetarias en Number()/roundMoney() (ver
--      validators.js, orders/sales/products controllers). Si algún endpoint
--      nuevo devuelve el valor crudo, normalizarlo antes de responder.
--
-- VERIFICACIÓN POST-MIGRACIÓN (debe devolver 0 en todas):
--   SELECT 'products' t, COUNT(*) FROM products WHERE price IS NULL AND id IS NOT NULL
--   UNION ALL SELECT 'orders', COUNT(*) FROM orders WHERE total IS NULL;
--
-- ROLLBACK MANUAL (solo si el paso 4 falló y hay backup): restaurar el
-- pg_dump del paso 1. No hay "down" automático a REAL porque implicaría
-- perder la exactitud ganada; si igual se necesita, por columna:
--   ALTER TABLE <t> ALTER COLUMN <c> TYPE REAL USING <c>::real;
-- =============================================================================

-- ---------- products.price (NOT NULL) ----------
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns
             WHERE table_name = 'products' AND column_name = 'price' AND data_type = 'real') THEN
    ALTER TABLE products ADD COLUMN IF NOT EXISTS price_numeric NUMERIC(12,2);
    UPDATE products SET price_numeric = ROUND(price::numeric, 2) WHERE price_numeric IS NULL AND price IS NOT NULL;
    IF EXISTS (SELECT 1 FROM products
               WHERE ABS(COALESCE(price_numeric, 0) - ROUND(COALESCE(price, 0)::numeric, 2)) > 0.001) THEN
      RAISE EXCEPTION 'products.price: hay filas que no coinciden tras la conversión';
    END IF;
    ALTER TABLE products DROP COLUMN price;
    ALTER TABLE products RENAME COLUMN price_numeric TO price;
    ALTER TABLE products ALTER COLUMN price SET NOT NULL;
  END IF;
END $$;

